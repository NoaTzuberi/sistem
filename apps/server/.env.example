# Copy to apps/server/.env and fill in. Never commit real values.
# On Render the same names are set in the dashboard (render.yaml lists them; docs/deploy/render.md).

# Server (a host like Render sets PORT itself — do not set it there)
PORT=5002
NODE_ENV=development

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/sistem

# JWT signing secret — must be a long random value in production (server refuses the default)
JWT_SECRET=change-me

# Websites allowed to call the API (CORS): comma-separated origins — scheme + host + port, no path.
# Never '*'. Unset/empty in development = both local apps (5173, 5174) on localhost AND 127.0.0.1;
# empty in production = no website. A value replaces the defaults, so list every origin you open.
# Production example: https://<user>.github.io
CLIENT_ORIGINS=
# Public URL of the client app, used in password-reset links
CLIENT_URL=http://localhost:5173

# Public URL of the coach dashboard, used in the admin's one-time "set password" links
DASHBOARD_URL=http://localhost:5174

# Accounts & relationships. The account with this email gets the admin role at server start
# (idempotent; it creates and suspends coaches in the dashboard). Empty = no admin by env.
ADMIN_EMAIL=
# Used only by `npm run create:admin` (creates the ADMIN_EMAIL account, or adds the admin role).
# 12+ characters, never the seed:dev password. Prefer passing it in the shell instead of keeping it here:
#   ADMIN_PASSWORD=... npm run create:admin
ADMIN_PASSWORD=
# Optional display name for a NEW admin account (default: Admin).
ADMIN_NAME=
# true = a trainee may have several live coachings at once (e.g. pilates + gym). Default off:
# one coach per trainee, enforced in code (no migration needed to turn it on).
MULTI_COACH_ENABLED=

# Email (Resend) — password reset (Backlog). Leave empty to skip sending.
RESEND_API_KEY=
EMAIL_FROM=Sistem <onboarding@resend.dev>

# AI plan recommendations for the coach (Phase 12) — Google Gemini API, FREE TIER, DEV ONLY.
# The free tier may use what we send to improve Google's products: never send real trainee
# data with it (PRD §14). Without a key, AI drafts are simply off.
# Get a key in Google AI Studio -> API keys.
GEMINI_API_KEY=
# Optional: the model (default gemini-3.8-flash) and the fallback model tried when it is
# overloaded / out of free quota / declines (default gemini-3.5-flash-lite; 'none' = off).
AI_MODEL=
AI_FALLBACK_MODEL=
# The AI never runs when NODE_ENV=production unless this is 'true' — set it only once the
# provider is a paid tier whose terms exclude training on our data.
AI_PAID_TIER=

# Voyage embeddings for the knowledge (RAG) feature — used by seed:knowledge and the AI drafts
VOYAGE_API_KEY=

# Cloudinary — onboarding media (media:upload script, Phase 2c) and private photos: Daily Pump
# (Phase 9, authenticated assets + 1-hour signed links), progress photos (Phase 10).
# Dashboard -> Settings -> API Keys. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Kaggle account token for downloading the exercise CSV into data/raw before import:exercises — the server never reads it.
KAGGLE_API_TOKEN=

# Feature flags (Phase 13b nutrition features — built but closed; meal logging opened in 13a+). 'true' opens one; anything
# else (or unset) keeps it closed: its routes answer 404 and the apps hide its UI.
FEATURE_NUTRITION_RECIPES=
FEATURE_WATER_TRACKING=
