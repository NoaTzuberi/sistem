{
  "name": "sistem",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,mobile -c magenta,cyan \"npm:dev:server\" \"npm:dev:mobile\"",
    "dev:all": "concurrently -k -n server,mobile,dashboard -c magenta,cyan,yellow \"npm:dev:server\" \"npm:dev:mobile\" \"npm:dev:dashboard\"",
    "dev:phone": "node scripts/dev-phone.mjs",
    "dev:server": "npm run dev -w @sistem/server",
    "dev:mobile": "npm run dev -w @sistem/mobile",
    "dev:dashboard": "npm run dev -w @sistem/dashboard",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run lint:i18n && npm run lint:contrast",
    "test": "npm run test --workspaces --if-present && npm run test:i18n",
    "import:exercises": "npm run import:exercises -w @sistem/server",
    "clean:exercise-names": "npm run clean:exercise-names -w @sistem/server",
    "group:exercises": "npm run group:exercises -w @sistem/server",
    "seed:knowledge": "npm run seed:knowledge -w @sistem/server",
    "promote:coach": "npm run promote:coach -w @sistem/server --",
    "create:admin": "npm run create:admin -w @sistem/server --",
    "seed:dev": "npm run seed:dev -w @sistem/server --",
    "seed:nutrition": "npm run seed:nutrition -w @sistem/server --",
    "reset:nutrition": "npm run reset:nutrition -w @sistem/server --",
    "backfill:achievements": "npm run backfill:achievements -w @sistem/server --",
    "test:i18n": "vitest run --config vitest.i18n.config.mts",
    "lint:i18n": "node scripts/i18n-audit.mjs",
    "lint:contrast": "node scripts/contrast-audit.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
