# Environment variables (global safety net — client/ and server/ also ignore their own)
.env
.env.*
!.env.example

# Dependencies (global safety net)
node_modules/

# Build output (every app)
dist/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Logs
*.log

# Original onboarding stock footage (~1 GB) — never committed. The app plays the compressed
# copies from Cloudinary (Phase 2c: npm run media:compress / media:upload -w @sistem/server)
apps/mobile/src/assets/onBoardingvid/

# The coach's own reference content (nutrition guide + review notes) — the repo will become public
docs/reference/
# Notes on third-party data sources and licenses — kept locally, not in the public repo
docs/THIRD_PARTY_CONTENT.md

# Local-only files (kept on disk, not in the repo)
workdes.txt
skills-lock.json
AGENTS.md
CLAUDE.md
.agents/
.claude/

# Static design previews (local only)
docs/design-preview/
